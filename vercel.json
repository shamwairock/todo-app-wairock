{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "publish-output/wwwroot",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    }
  ]
}
