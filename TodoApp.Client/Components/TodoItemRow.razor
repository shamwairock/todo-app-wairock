@inject IJSRuntime JS

<li class="todo-item priority-@(Item.Priority.ToString().ToLowerInvariant()) @(Item.Done ? "done" : "") @(Removing ? "removing" : "")">
    <input type="checkbox" checked="@Item.Done" @onchange="HandleToggle" />
    <span class="todo-text">@Item.Text</span>
    <span class="priority-badge priority-@(Item.Priority.ToString().ToLowerInvariant())">@Item.Priority</span>
    @if (Item.Done)
    {
        <span class="points-badge">+@Item.PointsEarned</span>
    }
    <button type="button" class="icon-btn edit-btn" @ref="_editBtn" title="Edit" disabled="@Item.Done" @onclick="HandleEdit">
        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg>
    </button>
    <button type="button" class="icon-btn delete-btn" @ref="_deleteBtn" title="Delete" disabled="@Item.Done" @onclick="HandleDelete">
        <svg viewBox="0 0 24 24"><path d="M6 7h12l-1 14H7L6 7zm3-4h6l1 2h4v2H2V5h4l1-2z" /></svg>
    </button>
</li>

@code {
    [Parameter, EditorRequired] public TodoItem Item { get; set; } = null!;
    [Parameter] public bool Removing { get; set; }
    [Parameter] public EventCallback<TodoItem> OnToggle { get; set; }
    [Parameter] public EventCallback<TodoItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TodoItem> OnDelete { get; set; }

    private ElementReference _editBtn;
    private ElementReference _deleteBtn;

    private Task HandleToggle() => OnToggle.InvokeAsync(Item);

    private async Task HandleEdit()
    {
        await JS.InvokeVoidAsync("todoEffects.pulse", _editBtn);
        await OnEdit.InvokeAsync(Item);
    }

    private async Task HandleDelete()
    {
        await JS.InvokeVoidAsync("todoEffects.pulse", _deleteBtn);
        await OnDelete.InvokeAsync(Item);
    }
}
